# Optional overrides for the public DhilTrip Sanity configuration.
NEXT_PUBLIC_SANITY_PROJECT_ID=rsnabcto
NEXT_PUBLIC_SANITY_DATASET=packages
NEXT_PUBLIC_SANITY_API_VERSION=2026-10-08

# Web3Forms access key: lets the contact form send a copy of each message to dhiltrip@gmail.com.
# Create it at https://web3forms.com with the Dhil Trip email, then set it here (local) and in Vercel.
# Leave empty to send messages through WhatsApp only.
NEXT_PUBLIC_WEB3FORMS_KEY=

# Firebase web config (public) — from Firebase console > Project settings > Your apps.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Secret: path to the service account JSON locally, or put the JSON itself in FIREBASE_SERVICE_ACCOUNT on Vercel.
FIREBASE_SERVICE_ACCOUNT_FILE=firebase-admin.json
FIREBASE_SERVICE_ACCOUNT=
ADMIN_EMAILS=
LEADER_EMAILS=
